turn '';\n    },\n    formatJoinTime: function formatJoinTime(timeStr) {\n      if (timeStr) {\n        return timeStr.substring(0, 10) + ' ';\n      }\n      return '';\n    },\n    showEditBio: function showEditBio() {\n      this.editBioText = this.userInfo.bio || '';\n      this.editBioVisible = true;\n    },\n    updateBio: function updateBio() {\n      var _this4 = this;\n      this.$api.post({\n        url: '/user/info',\n        data: {\n          bio: this.editBioText\n        }\n      }).then(function (res) {\n        if (res.status_code === 1) {\n          _this4.userInfo.bio = _this4.editBioText;\n          _this4.$globalData.userInfo.bio = _this4.editBioText;\n          _this4.editBioVisible = false;\n          _this4.$message.success('个人简介更新成功');\n        } else {\n          _this4.$message.error('更新失败：' + res.msg);\n        }\n      }).catch(function (error) {\n        console.error('更新个人简介失败:', error);\n        _this4.$message.error('更新失败');\n      });\n    }\n  }\n};",{"version":3,"names":["AppHead","AppBody","AppFoot","name","components","data","userInfo","id","nickname","avatar","bio","city","signInTime","goodsList","currentPage","pageSize","totalGoods","userId","isOwnStore","editBioVisible","editBioText","mounted","_this","$route","params","getUserInfo","then","$globalData","loadStoreData","parseInt","methods","_getUserInfo","_asyncToGenerator","regeneratorRuntime","mark","_callee","res","wrap","_callee$","_context","prev","next","$api","sent","status_code","t0","console","error","stop","apply","arguments","loadUserPublicInfo","loadUserGoods","_this2","_objectSpread","catch","get","url","$message","$router","push","_this3","page","nums","list","count","handlePageChange","toGoodsDetail","goodsId","path","query","getFirstImage","pictureList","images","JSON","parse","length","$store","state","baseApi","e","formatTime","timeStr","substring","formatJoinTime","showEditBio","updateBio","_this4","post","success","msg"],"sources":["src/components/page/store-front.vue"],"sourcesContent":["<template>\r\n    <div>\r\n        <app-head></app-head>\r\n        <app-body>\r\n            <div class=\"store-container\">\r\n                <!-- 用户信息区域 -->\r\n                <div class=\"user-info-section\">\r\n                    <div class=\"user-avatar\">\r\n                        <el-image \r\n                            :src=\"$store.state.baseApi + userInfo.avatar\" \r\n                            style=\"width: 120px; height: 120px; border-radius: 10px;\"\r\n                            fit=\"cover\">\r\n                            <div slot=\"error\" class=\"image-slot\">\r\n                                <i class=\"el-icon-picture-outline\"></i>\r\n                            </div>\r\n                        </el-image>\r\n                    </div>\r\n                    <div class=\"user-details\">\r\n                        <h2 class=\"user-nickname\">{{ userInfo.nickname }}</h2>\r\n                        <div class=\"user-meta\">\r\n                            <p class=\"user-city\">\r\n                                <i class=\"el-icon-location\"></i>\r\n                                {{ userInfo.city || '未知城市' }}\r\n                            </p>\r\n                            <p class=\"user-join-time\">\r\n                                <i class=\"el-icon-time\"></i>\r\n                                {{ formatJoinTime(userInfo.signInTime) }}加入平台\r\n                            </p>\r\n                        </div>\r\n                        <div class=\"user-bio\">\r\n                            <p v-if=\"userInfo.bio\">{{ userInfo.bio }}</p>\r\n                            <p v-else class=\"no-bio\">这个用户很懒，什么都没有留下~</p>\r\n                        </div>\r\n                        <!-- 如果是自己的橱窗，显示编辑按钮 -->\r\n                        <div v-if=\"isOwnStore\" class=\"edit-bio-section\">\r\n                            <el-button size=\"mini\" type=\"primary\" @click=\"showEditBio\">编辑个人简介</el-button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- 商品展示区域 -->\r\n                <div class=\"goods-section\">\r\n                    <div class=\"section-header\">\r\n                        <h3>TA的商品 ({{ totalGoods }})</h3>\r\n                    </div>\r\n                    \r\n                    <div v-if=\"goodsList.length > 0\" class=\"goods-grid\">\r\n                        <div \r\n                            class=\"goods-item\" \r\n                            v-for=\"item in goodsList\" \r\n                            :key=\"item.id\"\r\n                            @click=\"toGoodsDetail(item.id)\">\r\n                            <div class=\"goods-image\">\r\n                                <el-image \r\n                                    :src=\"getFirstImage(item.pictureList)\"\r\n                                    style=\"width: 100%; height: 200px;\"\r\n                                    fit=\"cover\">\r\n                                    <div slot=\"error\" class=\"image-slot\">\r\n                                        <i class=\"el-icon-picture-outline\"></i>\r\n                                    </div>\r\n                                </el-image>\r\n                            </div>\r\n                            <div class=\"goods-info\">\r\n                                <h4 class=\"goods-title\">{{ item.idleName }}</h4>\r\n                                <p class=\"goods-price\">￥{{ item.idlePrice }}</p>\r\n                                <div class=\"goods-meta\">\r\n                                    <span class=\"goods-location\">{{ item.idlePlace }}</span>\r\n                                    <span class=\"goods-time\">{{ formatTime(item.releaseTime) }}</span>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    \r\n                    <div v-else class=\"no-goods\">\r\n                        <el-empty \r\n                            description=\"暂无商品\"\r\n                            :image-size=\"100\">\r\n                        </el-empty>\r\n                    </div>\r\n\r\n                    <!-- 分页 -->\r\n                    <div v-if=\"totalGoods > pageSize\" class=\"pagination-section\">\r\n                        <el-pagination\r\n                            @current-change=\"handlePageChange\"\r\n                            :current-page=\"currentPage\"\r\n                            layout=\"prev, pager, next\"\r\n                            :page-size=\"pageSize\"\r\n                            :total=\"totalGoods\">\r\n                        </el-pagination>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- 编辑个人简介对话框 -->\r\n            <el-dialog \r\n                title=\"编辑个人简介\" \r\n                :visible.sync=\"editBioVisible\"\r\n                width=\"30%\">\r\n                <el-input\r\n                    type=\"textarea\"\r\n                    v-model=\"editBioText\"\r\n                    placeholder=\"介绍一下自己吧~\"\r\n                    :rows=\"4\"\r\n                    maxlength=\"200\"\r\n                    show-word-limit>\r\n                </el-input>\r\n                <span slot=\"footer\" class=\"dialog-footer\">\r\n                    <el-button @click=\"editBioVisible = false\">取 消</el-button>\r\n                    <el-button type=\"primary\" @click=\"updateBio\">确 定</el-button>\r\n                </span>\r\n            </el-dialog>\r\n\r\n            <app-foot></app-foot>\r\n        </app-body>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport AppHead from '../common/AppHeader.vue';\r\nimport AppBody from '../common/AppPageBody.vue';\r\nimport AppFoot from '../common/AppFoot.vue';\r\n\r\nexport default {\r\n    name: \"store-front\",\r\n    components: {\r\n        AppHead,\r\n        AppBody,\r\n        AppFoot\r\n    },\r\n    data() {\r\n        return {\r\n            userInfo: {\r\n                id: null,\r\n                nickname: '',\r\n                avatar: '',\r\n                bio: '',\r\n                city: '',\r\n                signInTime: ''\r\n            },\r\n            goodsList: [],\r\n            currentPage: 1,\r\n            pageSize: 12,\r\n            totalGoods: 0,\r\n            userId: null,\r\n            isOwnStore: false,\r\n            editBioVisible: false,\r\n            editBioText: ''\r\n        };\r\n    },\r\n    mounted() {\r\n        this.userId = this.$route.params.userId;\r\n        \r\n        // 如果没有指定用户ID，则显示当前用户的橱窗\r\n        if (!this.userId) {\r\n            this.getUserInfo().then(() => {\r\n                this.userId = this.$globalData.userInfo.id;\r\n                this.isOwnStore = true;\r\n                this.loadStoreData();\r\n            });\r\n        } else {\r\n            this.userId = parseInt(this.userId);\r\n            // 检查是否是自己的橱窗\r\n            this.getUserInfo().then(() => {\r\n                this.isOwnStore = this.userId === this.$globalData.userInfo.id;\r\n                this.loadStoreData();\r\n            });\r\n        }\r\n    },\r\n    methods: {\r\n        async getUserInfo() {\r\n            if (!this.$globalData.userInfo.id) {\r\n                try {\r\n                    const res = await this.$api.getUserInfo();\r\n                    if (res.status_code === 1) {\r\n                        this.$globalData.userInfo = res.data;\r\n                    }\r\n                } catch (error) {\r\n                    console.error('获取用户信息失败:', error);\r\n                }\r\n            }\r\n        },\r\n        loadStoreData() {\r\n            this.loadUserPublicInfo();\r\n            this.loadUserGoods();\r\n        },\r\n        loadUserPublicInfo() {\r\n            if (this.isOwnStore) {\r\n                // 对于自己的橱窗，也通过API获取最新用户信息，确保数据完整性\r\n                this.$api.getUserInfo().then(res => {\r\n                    if (res.status_code === 1) {\r\n                        this.userInfo = res.data;\r\n                    } else {\r\n                        // 如果API失败，使用本地数据作为备用\r\n                        this.userInfo = { ...this.$globalData.userInfo };\r\n                    }\r\n                }).catch(error => {\r\n                    console.error('获取自己用户信息失败:', error);\r\n                    // API失败时使用本地数据\r\n                    this.userInfo = { ...this.$globalData.userInfo };\r\n                });\r\n            } else {\r\n                // 获取其他用户的公开信息\r\n                this.$api.get({\r\n                    url: '/user/public-info',\r\n                    params: { userId: this.userId }\r\n                }).then(res => {\r\n                    if (res.status_code === 1) {\r\n                        this.userInfo = res.data;\r\n                    } else {\r\n                        this.$message.error('获取用户信息失败');\r\n                        this.$router.push('/');\r\n                    }\r\n                }).catch(error => {\r\n                    console.error('获取用户公开信息失败:', error);\r\n                    this.$message.error('获取用户信息失败');\r\n                    this.$router.push('/');\r\n                });\r\n            }\r\n        },\r\n        loadUserGoods() {\r\n            this.$api.get({\r\n                url: '/idle/user-published',\r\n                params: {\r\n                    userId: this.userId,\r\n                    page: this.currentPage,\r\n                    nums: this.pageSize\r\n                }\r\n            }).then(res => {\r\n                if (res.status_code === 1) {\r\n                    this.goodsList = res.data.list || [];\r\n                    this.totalGoods = res.data.count || 0;\r\n                } else {\r\n                    this.$message.error('获取商品列表失败');\r\n                }\r\n            }).catch(error => {\r\n                console.error('获取用户商品失败:', error);\r\n                this.$message.error('获取商品列表失败');\r\n            });\r\n        },\r\n        handlePageChange(page) {\r\n            this.currentPage = page;\r\n            this.loadUserGoods();\r\n        },\r\n        toGoodsDetail(goodsId) {\r\n            this.$router.push({\r\n                path: '/details',\r\n                query: { id: goodsId }\r\n            });\r\n        },\r\n        getFirstImage(pictureList) {\r\n            try {\r\n                if (pictureList) {\r\n                    const images = JSON.parse(pictureList);\r\n                    if (images && images.length > 0) {\r\n                        return this.$store.state.baseApi + images[0];\r\n                    }\r\n                }\r\n                return '';\r\n            } catch (e) {\r\n                return '';\r\n            }\r\n        },\r\n        formatTime(timeStr) {\r\n            if (timeStr) {\r\n                return timeStr.substring(0, 10);\r\n            }\r\n            return '';\r\n        },\r\n        formatJoinTime(timeStr) {\r\n            if (timeStr) {\r\n                return timeStr.substring(0, 10) + ' ';\r\n            }\r\n            return '';\r\n        },\r\n        showEditBio() {\r\n            this.editBioText = this.userInfo.bio || '';\r\n            this.editBioVisible = true;\r\n        },\r\n        updateBio() {\r\n            this.$api.post({\r\n                url: '/user/info',\r\n                data: {\r\n                    bio: this.editBioText\r\n                }\r\n            }).then(res => {\r\n                if (res.status_code === 1) {\r\n                    this.userInfo.bio = this.editBioText;\r\n                    this.$globalData.userInfo.bio = this.editBioText;\r\n                    this.editBioVisible = false;\r\n                    this.$message.success('个人简介更新成功');\r\n                } else {\r\n                    this.$message.error('更新失败：' + res.msg);\r\n                }\r\n            }).catch(error => {\r