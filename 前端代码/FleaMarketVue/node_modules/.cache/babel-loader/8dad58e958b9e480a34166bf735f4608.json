 </el-input>\n                    <el-input\n                            class=\"release-idle-detiles-text\"\n                            type=\"textarea\"\n                            autosize\n                            placeholder=\"请输入物品的详细介绍...\"\n                            v-model=\"idleItemInfo.idleDetails\"\n                            maxlength=\"1000\"\n                            show-word-limit>\n                    </el-input>\n                    <div class=\"release-idle-place\">\n                        <div class=\"release-tip\">您的地区</div>\n                        <el-cascader\n                                :options=\"options\"\n                                v-model=\"selectedOptions\"\n                                @change=\"handleChange\"\n                                :separator=\"' '\"\n                                style=\"width: 90%;\"\n                        >\n                        </el-cascader>\n                    </div>\n                    \n                    <!-- 商品类别选择 -->\n                    <div class=\"form-item\">\n                        <div class=\"release-tip\">物品类别</div>\n                        <el-select v-model=\"idleItemInfo.idleLabel\" placeholder=\"请选择类别\">\n                            <el-option\n                                    v-for=\"item in options2\"\n                                    :key=\"item.value\"\n                                    :label=\"item.label\"\n                                    :value=\"item.value\">\n                            </el-option>\n                        </el-select>\n                    </div>\n                    \n                    <!-- 价格和库存输入区 -->\n                    <div class=\"price-stock-container\">\n                        <div class=\"form-item\">\n                            <div class=\"input-label\">商品价格</div>\n                            <el-input-number \n                                v-model=\"idleItemInfo.idlePrice\" \n                