og(e);\n      });\n    },\n    unsealUser: function unsealUser(i) {\n      var _this5 = this;\n      this.$api.updateUserStatus({\n        id: this.badUserData[i].id,\n        status: 0\n      }).then(function (res) {\n        if (res.status_code == 1) {\n          _this5.getBadUserData();\n        } else {\n          _this5.$message.error(res.msg);\n        }\n      }).catch(function (e) {\n        console.log(e);\n      });\n    },\n    regAdmin: function regAdmin() {\n      var _this6 = this;\n      if (this.adminPassword == this.adminRePassword) {\n        this.$api.regAdministrator({\n          adminName: this.adminName,\n          accountNumber: this.adminAccount,\n          adminPassword: this.adminPassword\n        }).then(function (res) {\n          if (res.status_code == 1) {\n            _this6.total = _this6.total + 1;\n            _this6.nowPage = Math.ceil(_this6.total / 8);\n            console.log(_this6.nowPage);\n            _this6.getUserManage();\n          } else {\n            _this6.$message.error(res.msg);\n          }\n        }).catch(function (e) {\n          console.log(e);\n          _this6.$message.error(\"添加失败，账号重复或网络异常\");\n        });\n        this.adminRegVisible = false;\n      } else {\n        this.$message.error(\"两次输入的密码不一致\");\n      }\n    },\n    // 新增：用户等级管理相关方法\n    showLevelDialog: function showLevelDialog(index) {\n      this.currentUser = this.userData[index];\n      this.newUserLevel = this.currentUser.userLevel || 1;\n      this.levelDialogVisible = true;\n    },\n    updateUserLevel: function updateUserLevel() {\n      var _this7 = this;\n      if (!this.currentUser || !this.newUserLevel) {\n        this.$message.error(\"请选择有效的用户等级\");\n        return;\n      }\n      this.levelUpdating = true;\n      this.$api.updateUserLevel({\n        userId: this.currentUser.id,\n        userLevel: this.newUserLevel\n      }).then(function (res) {\n        if (res.status_code == 1) {\n          _this7.$message.success(\"用户等级更新成功\");\n          _this7.levelDialogVisible = false;\n          _this7.getUserData(); // 刷新用户列表\n        } else {\n          _this7.$message.error(res.msg || \"更新失败\");\n        }\n      }).catch(function (e) {\n        console.log(e);\n        _this7.$message.error(\"更新失败，网络异常\");\n      }).finally(function () {\n        _this7.levelUpdating = false;\n      });\n    },\n    getLevelText: function getLevelText(level) {\n      var levelMap = {\n        1: \"等级1\",\n        2: \"等级2\",\n        3: \"等级3\",\n        4: \"等级4\",\n        5: \"等级5\"\n      };\n      return levelMap[level] || \"等级1\";\n    },\n    getLevelTagType: function getLevelTagType(level) {\n      var typeMap = {\n        1: \"success\",\n        2: \"info\",\n        3: \"warning\",\n        4: \"warning\",\n        5: \"danger\"\n      };\n      return typeMap[level] || \"success\";\n    }\n  },\n  data: function data() {\n    return {\n      mode: 1,\n      nowPage: 1,\n      total: 63,\n      adminRegVisible: false,\n      adminAccount: '',\n      adminPassword: '',\n      adminRePassword: '',\n      adminName: '',\n      userData: [],\n      badUserData: [],\n      userManage: [],\n      // 新增：用户等级管理相关数据\n      levelDialogVisible: false,\n      currentUser: null,\n      newUserLevel: 1,\n      levelUpdating: false\n    };\n  }\n};",{"version":3,"names":["name","created","getUserData","methods","handleCurrentChange","val","nowPage","mode","getBadUserData","getUserManage","handleSelect","_this","$api","page","nums","status","then","res","status_code","userData","data","list","total","count","$message","error","msg","catch","e","console","log","_this2","badUserData","_this3","userManage","sealUser","i","_this4","id","updateUserStatus","unsealUser","_this5","regAdmin","_this6","adminPassword","adminRePassword","regAdministrator","adminName","accountNumber","adminAccount","Math","ceil","adminRegVisible","showLevelDialog","index","currentUser","newUserLevel","userLevel","levelDialogVisible","updateUserLevel","_this7","levelUpdating","userId","success","finally","getLevelText","level","levelMap","getLevelTagType","typeMap"],"sources":["src/components/common/userList.vue"],"sourcesContent":["<template>\n    <div class=\"main-border\">\n        <el-menu default-active=\"1\" class=\"el-menu-demo\" mode=\"horizontal\" @select=\"handleSelect\">\n            <el-menu-item index=\"1\">正常用户</el-menu-item>\n            <el-menu-item index=\"2\">违规用户</el-menu-item>\n            <el-menu-item index=\"3\">管理员</el-menu-item>\n\n            <div v-show=\"this.mode ==3\" class=\"addAdminButton\">\n                <el-button size=\"mini\" type=\"success\" @click=\"adminRegVisible = true\"> 添加管理员</el-button>\n                <el-dialog\n                        title=\"添加管理员\"\n                        :visible.sync=\"adminRegVisible\"\n                        width=\"25%\"\n                       >\n                    <span style=\"margin-left: 10px\">新增管理员名称</span>\n                    <el-input v-model=\"adminName\"  maxlength=\"8\" placeholder=\"请输入管理员名称\" style=\"padding: 10px 0\" clearable required></el-input>\n                    <span style=\"margin-left: 10px\">新增管理员账号</span>\n                    <el-input v-model=\"adminAccount\" minlength=\"8\" maxlength=\"10\" placeholder=\"请输入管理员账户\" style=\"padding: 10px 0\"\n                               clearable required></el-input>\n                    <span style=\"margin-left: 10px\">新增管理员密码</span>\n                    <el-input v-model=\"adminPassword\" minlength=\"8\" placeholder=\"请输入管理员密码\" style=\"padding: 10px 0\" show-password required></el-input>\n                    <span style=\"margin-left: 10px\">确认管理员密码</span>\n                    <el-input v-model=\"adminRePassword\" minlength=\"10\" placeholder=\"请再次输入管理员密码\" style=\"padding: 10px 0\" show-password required></el-input>\n                    <span slot=\"footer\" class=\"dialog-footer\">\n                        <el-button type=\"primary\" @click=\"regAdmin\"> 添加</el-button>\n                    </span>\n                </el-dialog>\n\n            </div>\n        </el-menu>\n        \n        <!-- 新增：用户等级设置对话框 -->\n        <el-dialog\n                title=\"设置用户等级\"\n                :visible.sync=\"levelDialogVisible\"\n                width=\"30%\">\n            <div style=\"margin-bottom: 20px\">\n                <span>用户信息：</span>\n                <div v-if=\"currentUser\" style=\"margin-top: 10px; padding: 10px; background-color: #f5f5f5; border-radius: 4px;\">\n                    <p><strong>账号：</strong>{{ currentUser.accountNumber }}</p>\n                    <p><strong>昵称：</strong>{{ currentUser.nickname }}</p>\n                    <p><strong>当前等级：</strong>{{ getLevelText(currentUser.userLevel) }}</p>\n                </div>\n            </div>\n            <div style=\"margin-bottom: 20px\">\n                <span style=\"margin-right: 10px\">新等级：</span>\n                <el-select v-model=\"newUserLevel\" placeholder=\"请选择用户等级\" style=\"width: 200px\">\n                    <el-option label=\"等级1 (服务费0.1%)\" :value=\"1\"></el-option>\n                    <el-option label=\"等级2 (服务费0.2%)\" :value=\"2\"></el-option>\n                    <el-option label=\"等级3 (服务费0.5%)\" :value=\"3\"></el-option>\n                    <el-option label=\"等级4 (服务费0.75%)\" :value=\"4\"></el-option>\n                    <el-option label=\"等级5 (服务费1%)\" :value=\"5\"></el-option>\n                </el-select>\n            </div>\n            <div style=\"margin-bottom: 20px; color: #909399; font-size: 14px\">\n                <p><strong>说明：</strong></p>\n                <p>• 用户等级决定了卖家在交易中需要支付的服务费费率</p>\n                <p>• 等级越高，服务费费率越高</p>\n                <p>• 服务费仅向卖家征收，不对买家征收</p>\n            </div>\n            <span slot=\"footer\" class=\"dialog-footer\">\n                <el-button @click=\"levelDialogVisible = false\">取消</el-button>\n                <el-button type=\"primary\" @click=\"updateUserLevel\" :loading=\"levelUpdating\">确定</el-button>\n            </span>\n        </el-dialog>\n        <el-table v-show=\"this.mode == 1\"\n                  :data=\"userData\"\n                  stripe\n                  style=\"width: 100%;color: #5a5c61;\">\n            <el-table-column label=\"头像\" width=\"50\">\n                <template slot-scope=\"scope\">\n                    <el-avatar shape=\"square\" :size=\"23\" :src=\"$store.state.baseApi + scope.row.avatar\"></el-avatar>\n                </template>\n            </el-table-column>\n            <el-table-column\n                    prop=\"accountNumber\"\n                    label=\"用户账号\"\n                    show-overflow-tooltip\n                    min-width=\"150\"\n                    width=\"150\">\n            </el-table-column>\n            <el-table-column\n                    prop=\"nickname\"\n                    label=\"用户昵称\"\n                    show-overflow-tooltip\n                    min-width=\"150\"\n                    width=\"150\">\n            </el-table-column>\n            <el-table-column\n                    prop=\"signInTime\"\n                    label=\"注册时间\"\n                    show-overflow-tooltip\n                    width=\"200\">\n            </el-table-column>\n            <el-table-column\n                    label=\"用户等级\"\n                    width=\"100\">\n                <template slot-scope=\"scope\">\n                    <el-tag :type=\"getLevelTagType(scope.row.userLevel)\">\n                        {{ getLevelText(scope.row.userLevel) }}\n                    </el-tag>\n                </template>\n            </el-table-column>\n            <el-table-column label=\"操作\" width=\"200\">\n                <template slot-scope=\"scope\">\n                    <div class=\"operation-buttons\">\n                        <el-button\n                                size=\"mini\"\n                                type=\"primary\"\n                                @click=\"showLevelDialog(scope.$index)\">设置等级</el-button>\n                        <el-button\n                                size=\"mini\"\n                                type=\"danger\"\n                                @click=\"sealUser(scope.$index)\">封号</el-button>\n                    </div>\n                </template>\n            </el-table-column>\n        </el-table>\n        <el-table v-show=\"this.mode == 2\"\n                  :data=\"badUserData\"\n                  stripe\n                  style=\"width: 100%;color: #5a5c61;\">\n            <el-table-column\n                    label=\"头像\"\n                    width=\"50\">\n                <template slot-scope=\"scope\">\n                    <el-avatar shape=\"square\" :size=\"23\" :src=\"$store.state.baseApi + scope.row.avatar\"></el-avatar>\n                </template>\n            </el-table-column>\n            <el-table-column\n                    prop=\"accountNumber\"\n                    label=\"用户账号\"\n                    show-overflow-tooltip\n                    min-width=\"150\"\n                    width=\"150\">\n            </el-table-column>\n            <el-table-column\n                    prop=\"nickname\"\n                    label=\"用户昵称\"\n                    show-overflow-tooltip\n                    width=\"150\"\n            >\n            </el-table-column>\n            <el-table-column\n                    prop=\"signInTime\"\n                    label=\"注册时间\"\n                    show-overflow-tooltip\n                    width=\"200\">\n            </el-table-column>\n            <el-table-column\n                    label=\"用户等级\"\n                    width=\"100\">\n                <template slot-scope=\"scope\">\n                    <el-tag :type=\"getLevelTagType(scope.row.userLevel)\">\n                        {{ getLevelText(scope.row.userLevel) }}\n                    </el-tag>\n                </template>\n            </el-table-column>\n            <el-table-column label=\"操作\" width=\"140\">\n                <template slot-scope=\"scope\">\n                    <el-button\n                            size=\"mini\"\n                            type=\"success\"\n                            @click=\"unsealUser(scope.$index)\"> 解封</el-button>\n                </template>\n            </el-table-column>\n        </el-table>\n        <el-table  v-show=\"this.mode == 3\"\n                :data=\"userManage\"\n                stripe\n                style=\"width: 100%;color: #5a5c61;\">\n            <el-table-column\n                    prop=\"accountNumber\"\n                    label=\"管理员账号\"\n                    show-overflow-tooltip\n                    width=\"200\">\n            </el-table-column>\n            <el-table-column\n                    prop=\"adminName\"\n                    label=\"管理名称\"\n                    >\n            </el-table-column>\n        </el-table>\n        <div class=\"block\">\n            <el-pagination\n                    @current-change=\"handleCurrentChange\"\n                    :current-page.sync=\"nowPage\"\n                    :page-size=\"7\"\n                    background\n                    layout=\"prev, pager, next,jumper\"\n                    :total=\"total\">\n            </el-pagination>\n        </div>\n    </div>\n</template>\n\n<script>\n    export default {\n        name: \"userList\",\n        created() {\n            this.getUserData();\n        },\n        methods: {\n            handleCurrentChange(val) {\n                this.nowPage = val;\n                if(this.mode == 1){\n                    this.getUserData();\n                }\n                if(this.mode == 2){\n                    this.getBadUserData();\n                }\n                if(this.mode == 3){\n                    this.getUserManage();\n                }\n            },\n            handleSelect(val){\n                if(this.mode !== val){\n                    this.mode = val\n                    if(val == 1){\n                        this.nowPage = 1;\n                        this.getUserData();\n                    }\n                    if(val == 2){\n                        this.nowPage = 1;\n                        this.getBadUserData();\n                    }\n                    if(val == 3){\n                        this.nowPage = 1;\n                        this.getUserManage();\n                    }\n                }\n            },\n            getUserData(){\n                //正常普通用户\n                this.$api.getUserData({\n                    page: this.nowPage,\n                    nums:8,\n                    status:0\n                }).then(res => {\n                    if(res.status_code==1){\n                        this.userData = res.data.list;\n                        this.total = res.data.count;\n                    }else {\n                        this.$message.error(res.msg)\n                    }\n                }).catch(e => {\n                    console.log(e)\n                })\n            },\n            getBadUserData(){\n                //违规用户\n                this.$api.getUserData({\n                    page: this.nowPage,\n                    nums:8,\n                    status:1\n                }).then(res => {\n                    if(res.status_code==1){\n                        this.badUserData = res.data.list;\n                        this.total = res.data.count;\n                    }else {\n                        this.$message.error(res.msg)\n                    }\n                }).catch(e => {\n                    console.log(e)\n                });\n            },\n            getUserManage(){\n                //管理员\n                this.$api.getUserManage({\n                    page: this.nowPage,\n                    nums:8,\n                }).then(res => {\n                    if(res.status_code==1){\n                        this.userManage = res.data.list;\n                        this.total = res.data.count;\n                    }else {\n                        this.$message.error(res.msg)\n                    }\n                }).catch(e => {\n                    console.log(e)\n                })\n            },\n            sealUser(i){\n                console.log( this.userData[i].id);\n                this.$api.updateUserStatus({\n                    id: this.userData[i].id,\n                    status:1\n                }).then(res => {\n                    if(res.status_code==1){\n                        this.getUserData();\n                    }else {\n                        this.$message.error(res.msg)\n                    }\n                }).catch(e => {\n                    console.log(e)\n                })\n            },\n            unsealUser(i){\n                this.$api.updateUserStatus({\n                    id: this.badUserData[i].id,\n                    status:0\n                }).then(res => {\n                    if(res.status_code==1){\n                        this.getBadUserData();\n                    }else {\n                        this.$message.error(res.msg)\n                    }\n\n                }).catch(e => {\n                    console.log(e)\n                })\n            },\n            regAdmin(){\n                if(this.adminPassword == this.adminRePassword){\n                    this.$api.regAdministrator({\n                        adminName: this.adminName,\n                        accountNumber: this.adminAccount,\n                        adminPassword: this.adminPassword,\n                    }).then(res => {\n                        if(res.status_code==1){\n                            this.total = this.total+1;\n                            this.nowPage= Math.ceil(this.total/8);\n                            console.log(this.nowPage);\n                            this.getUserManage();\n                        }else {\n                            this.$message.error(res.msg)\n                        }\n                    }).catch(e => {\n                        console.log(e);\n                        this.$message.error(\"添加失败，账号重复或网络异常\")\n                    });\n                    this.adminRegVisible = false\n                }\n                else {\n                    this.$message.error(\"两次输入的密码不一致\");\n                }\n            },\n            // 新增：用户等级管理相关方法\n            showLevelDialog(index) {\n                this.currentUser = this.userData[index];\n                this.newUserLevel = this.currentUser.userLevel || 1;\n                this.levelDialogVisible = true;\n            },\n            updateUserLevel() {\n                if (!this.currentUser || !this.newUserLevel) {\n                    this.$message.error(\"请选择有效的用户等级\");\n                    return;\n                }\n                \n                this.levelUpdating = true;\n                this.$api.updateUserLevel({\n                    userId: this.currentUser.id,\n                    userLevel: this.newUserLevel\n                }).then(res => {\n                    if (res.status_code == 1) {\n                        this.$message.success(\"用户等级更新成功\");\n                        this.levelDialogVisible = false;\n                        this.getUserData(); // 刷新用户列表\n                    } else {\n                        this.$message.error(res.msg || \"更新失败\");\n                    }\n                }).catch(e => {\n                    console.log(e);\n                    this.$message.error(\"更新失败，网络异常\");\n                }).finally(() => {\n                    this.levelUpdating = false;\n                });\n            },\n            getLevelText(level) {\n                const levelMap = {\n                    1: \"等级1\",\n                    2: \"等级2\", \n                    3: \"等级3\",\n                    4: \"等级4\",\n                    5: \"等级5\"\n                };\n                return levelMap[level] || \"等级1\";\n            },\n            getLevelTagType(level) {\n                const typeMap = {\n                    1: \"success\",\n                    2: \"info\",\n                    3: \"warning\", \n                    4: \"warning\",\n                    5: \"danger\"\n                };\n                return typeMap[level] || \"success\";\n            },\n        },\n        data(){\n            return {\n                mode:1,\n                nowPage: 1,\n                total: 63,\n                adminRegVisible: false,\n                adminAccount:'',\n                adminPassword:'',\n                adminRePassword:'',\n                adminName:'',\n                userData: [],\n                badUserData:[],\n                userManage:[],\n                // 新增：用户等级管理相关数据\n                levelDialogVisible: false,\n                currentUser: null,\n                newUserLevel: 1,\n                levelUpdating: false,\n            }\n        },\n    }\n</script>\n\n<style scoped>\n    .main-border{\n        background-color: #FFF;\n        padding: 10px 30px;\n        box-shadow: 0 1px 15px -6px rgba(0,0,0,.5);\n        border-radius: 5px;\n    }\n    .block {\n        display: flex;\n        justify-content:center;\n        padding-top: 15px;\n        padding-bottom: 10px;\n        width: 100%;\n    }\n    .addAdminButton{\n        display:flex;\n        justify-content: flex-end;\n        align-items: center;\n        height: 60px;\n        outline: none;\n    }\n    \n    /* 操作按钮样式 */\n    .operation-buttons {\n        display: flex;\n        gap: 8px;\n        align-items: center;\n        justify-content: flex-start;\n    }\n    \n    .operation-buttons .el-button {\n        width: 80px !important;\n        height: 28px !important;\n        padding: 6px 8px !important;\n        font-size: 12px !important;\n        line-height: 1 !important;\n        text-align: center !important;\n        border-radius: 4px !important;\n    }\n    \n    .operation-buttons .el-button span {\n        font-size: 12px !important;\n